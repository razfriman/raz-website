{
  "name": "raz-website",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "preview": "pnpm build && vite preview --port 3000",
    "preview:cf": "pnpm build:cf && CLOUDFLARE=1 vite preview --port 3000",
    "deploy:cf": " pnpm build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build": "vite build",
    "build:cf": "CLOUDFLARE=1 vite build",
    "serve": "vite preview",
    "serve:cf": "CLOUDFLARE=1 vite preview",
    "dev": "vite dev --port 3000",
    "dev:cf": "CLOUDFLARE=1 vite dev --port 3000",
    "check": "biome check --fix --unsafe",
    "check-types": "tsgo --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
        "@cloudflare/vite-plugin": "^1.21.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-start": "^1.157.5",
    "@tanstack/react-router": "^1.157.5",
    "@tanstack/react-router-devtools": "^1.157.5",
    "@tanstack/router-plugin": "^1.157.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "nitro": "^3.0.1-alpha.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vite-tsconfig-paths":"^6.0.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite":"^0.4.1",
    "@biomejs/biome": "2.3.12",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "8.0.0-beta.10",
     "wrangler": "^4.60.0"
  },
  "packageManager": "pnpm@10.8.1"
