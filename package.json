{
  "name": "raz-website",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "preview": "pnpm build && vite preview --port 3000",
    "preview:cf": "pnpm build:cf && CLOUDFLARE=1 vite preview --port 3000",
    "deploy:cf": " pnpm build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build": "vite build",
    "build:cf": "CLOUDFLARE=1 vite build",
    "serve": "vite preview",
    "serve:cf": "CLOUDFLARE=1 vite preview",
    "dev": "vite dev --port 3000",
    "dev:cf": "CLOUDFLARE=1 vite dev --port 3000",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@cloudflare/vite-plugin": "^1.28.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.167.1",
    "@tanstack/react-router-devtools": "^1.166.8",
    "@tanstack/react-start": "^1.166.12",
    "@tanstack/router-plugin": "^1.166.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260311-beta",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260315.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "vite": "8.0.0",
    "wrangler": "^4.73.0"
  },
  "packageManager": "pnpm@10.8.1"
}
