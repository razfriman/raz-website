{
  "name": "raz-website",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "preview": "pnpm build && vite preview --port 3000",
    "preview:cf": "pnpm build:cf && CLOUDFLARE=1 vite preview --port 3000",
    "deploy:cf": " pnpm build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build": "vite build",
    "build:cf": "CLOUDFLARE=1 vite build",
    "serve": "vite preview",
    "serve:cf": "CLOUDFLARE=1 vite preview",
    "dev": "vite dev --port 3000",
    "dev:cf": "CLOUDFLARE=1 vite dev --port 3000",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@cloudflare/vite-plugin": "^1.21.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.9.2",
    "@tanstack/react-router": "^1.157.15",
    "@tanstack/react-router-devtools": "^1.157.15",
    "@tanstack/react-start": "^1.157.15",
    "@tanstack/router-plugin": "^1.157.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.1-alpha.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.4.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260126.1",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "vite": "8.0.0-beta.10",
    "wrangler": "^4.60.0"
  },
  "packageManager": "pnpm@10.8.1"
}
